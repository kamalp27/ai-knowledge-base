# ==============================================================================
# AI Knowledge Base - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your environment.
# NEVER commit the actual .env file or production secrets to Git.

# --- Application Settings ---
APP_NAME="AI Knowledge Base"
APP_ENV=development                       # Set to "production" in production environments
APP_HOST=0.0.0.0
APP_PORT=8000                            # Local port; overridden automatically by $PORT in cloud environments
DEBUG=True                               # Set to False in production
API_V1_PREFIX=/api/v1

# --- CORS Security Policy ---
# Development: allows local Vite/React servers
# Production: comma-separated or JSON array of explicit domains. Wildcard '*' is strictly prohibited in production!
# Example Production: CORS_ORIGINS=https://ai-knowledge-base-frontend.onrender.com
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# --- Document & Persistent Storage Paths ---
# In containerized environments, point these beneath the mounted persistent disk (e.g. /app/data)
DATA_DIR=./data
RAW_DOCUMENTS_DIR=./data/raw_documents
VECTOR_STORE_DIR=./data/vector_store
EVAL_DATASETS_DIR=./data/eval_datasets
METADATA_DB_PATH=./data/metadata.db

# --- Upload Limits & Chunking ---
MAX_UPLOAD_SIZE_MB=15                    # Max single file upload in MB (rejects oversized uploads with HTTP 413)
CHUNK_SIZE=1000                          # Character count per chunk
CHUNK_OVERLAP=200                        # Character overlap between consecutive chunks

# --- Vector DB & Embeddings (Sentence Transformers + ChromaDB) ---
CHROMA_COLLECTION_NAME=knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=4                                  # Default number of passages to retrieve for synthesis
SIMILARITY_THRESHOLD=0.0

# --- LLM Providers & Generation Settings ---
# Options:
#  - "none": Raises HTTP 503 with configuration hint if query endpoint is invoked
#  - "fake": Deterministic keyword-grounded responses for local testing and CI (no external API needed)
#  - "openai": Production OpenAI API (requires OPENAI_API_KEY)
#  - "anthropic": Production Anthropic API (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# API Keys (Configure only in backend server environment; never expose to frontend)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# --- Frontend Configuration (Client-side) ---
# Set to backend URL with or without /api/v1:
# Development default (uses Vite proxy): (leave unset or /api/v1)
# Production example: VITE_API_BASE_URL=https://ai-knowledge-base-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
